    <inertial>
      <origin rpy="0 0 0" xyz="0.00033 -0.02204 -0.04762" />
      <mass value="2.797" />
      <inertia ixx="0.0156" ixy="0.0" ixz="0.0" iyy="0.01439" iyz="-0.0024" izz="0.005" />
    </inertial>
  </link>

  <joint name="panda_right_joint1" type="revolute">
    <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-2.8973" soft_upper_limit="2.8973" />
    <origin rpy="0 0 0" xyz="0 0 0.333" />
    <parent link="panda_right_link0" />
    <child link="panda_right_link1" />
    <axis xyz="0 0 1" />
    <dynamics damping="10.0" />
