<?xml version='1.0' encoding='utf-8'?>
<robot name="dual_panda_mj">
  <!--
    Dual Panda URDF for curobo MPC integration with dual_panda_ws ROS2 system.

    Base positions match ROBOT_CONFIGURATION.md:
      - Left arm: (0, 0.26, 0)
      - Right arm: (0, -0.26, 0)

    Joint names use panda_* prefix for curobo internal use.
    Mapping to ROS2 mj_* names is handled in the ROS2 bridge layer.
  -->
  <link name="world_base_link" />

  <!-- Right arm base: positioned at (0, -0.26, 0) matching ROS2/MuJoCo setup -->
  <joint name="world_to_right_arm" type="fixed">
    <parent link="world_base_link" />
    <child link="panda_right_base_link" />
    <origin rpy="0 0 0" xyz="0 -0.26 0" />
  </joint>
  <link name="panda_right_base_link" />
  <joint name="panda_right_fixed" type="fixed">
    <origin rpy="0 0 0.0" xyz="0 0 0.0" />
    <parent link="panda_right_base_link" />
    <child link="panda_right_link0" />
    <axis xyz="0 0 0" />
  </joint>

  <!-- Right arm links and joints -->
  <link name="panda_right_link0">
    <visual>
      <geometry>
        <mesh filename="meshes/visual/link0.dae" />
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="meshes/collision/link0.obj" />
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0172 0.0004 0.0745" />
      <mass value="2.3966" />
      <inertia ixx="0.0" ixy="0.0" ixz="0.002" iyy="0.0115" iyz="0.0" izz="0.0085" />
    </inertial>
  </link>

