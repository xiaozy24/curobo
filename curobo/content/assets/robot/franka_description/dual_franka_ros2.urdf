<?xml version="1.0"?>
<robot name="dual_franka_ros2">
  <!-- Base link matching ROS2 simulation -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
